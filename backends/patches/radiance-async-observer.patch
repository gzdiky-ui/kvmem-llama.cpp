+    Scheduler::StepResult result{};result.n_seq=2;result.n_accepted=accepted;result.token=tokens;result.eos=eos;
+    CHECK_OK(f.sch.observing([]{return RAD_OK;},[&](uint64_t id){return id==a;}));
+    CHECK_OK(f.sch.commit(result));
+    CHECK(f.sch.step()!=nullptr);CHECK_EQ(f.sch.plan().e.size(),size_t(1));CHECK_EQ(f.sch.plan().e[0].seq,b);
+    CHECK_OK(f.sch.cancel(a));CHECK_OK(f.sch.reap(a));
+    CHECK(f.kv.has_sequence(a));CHECK(f.sch.find(a)!=nullptr);
+    result.n_seq=1;CHECK_OK(f.sch.commit(result));f.sch.release_deferred();
+    CHECK(f.kv.has_sequence(a));
+    CHECK_OK(f.sch.observing([]{return RAD_OK;},[](uint64_t){return false;}));
