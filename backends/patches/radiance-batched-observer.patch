+TEST(observer_prefill_is_isolated_and_decode_remains_batched) {
+    Fixture f;f.build();f.cfg.max_seqs=4;CHECK_OK(f.start());f.sch.set_serial_prefill(true);
+    for(int i=0;i<4;++i)CHECK(f.submit(8,12)!=0);
+    int max_decode=0,steps=0,done=0;
+    while(steps++<100) {
+        if(!f.sch.step())break;
+        const auto& plan=f.sch.plan();bool prefill=false;
+        for(const auto& e:plan.e)prefill=prefill || e.is_prefill;
+        if(prefill)CHECK_EQ(plan.e.size(),size_t(1));
+        else max_decode=std::max(max_decode,int(plan.e.size()));
+        int32_t accepted[8]={},tokens[8]={5,5,5,5,5,5,5,5};uint8_t eos[8]={};
+        Scheduler::StepResult result{};result.n_seq=int(plan.e.size());
+        result.n_accepted=accepted;result.token=tokens;result.eos=eos;
+        CHECK_OK(f.sch.commit(result));
+        std::vector<uint64_t> completed;f.sch.take_completed(&completed);done+=int(completed.size());
+    }
+    CHECK_EQ(done,4);CHECK_EQ(max_decode,4);CHECK(steps<100);
+}
