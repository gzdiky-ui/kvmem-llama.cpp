+TEST(observer_storage_refusal_preserves_other_batch_entries) {
+    Fixture f;f.build();CHECK_OK(f.start());
+    const auto a=f.submit(8,4),b=f.submit(8,4),c=f.submit(8,4);
+    CHECK(f.sch.step()!=nullptr);CHECK_EQ(f.sch.plan().e.size(),size_t(3));
+    CHECK_EQ(f.sch.fail_observer(b,RAD_E_STATE),RAD_E_INVAL);
+    CHECK_OK(f.sch.fail_observer(b,RAD_E_IO));
+    CHECK(f.sch.find(b)->finish_reason=="storage");
+    int32_t accepted[3]={},tokens[3]={5,5,5};uint8_t eos[3]={};
+    Scheduler::StepResult result{};result.n_seq=3;
+    result.n_accepted=accepted;result.token=tokens;result.eos=eos;
+    CHECK_OK(f.sch.commit(result));
+    CHECK(f.kv.has_sequence(a));CHECK(!f.kv.has_sequence(b));CHECK(f.kv.has_sequence(c));
+    int done=0;
+    for(int i=0;i<10;++i) {
+        std::vector<uint64_t> ids;f.sch.take_completed(&ids);done+=int(ids.size());
+        if(!f.sch.step())break;
+        result.n_seq=int(f.sch.plan().e.size());CHECK_OK(f.sch.commit(result));
+    }
+    CHECK_EQ(done,3);
+    const auto next=f.submit(8,4);CHECK(f.sch.step()!=nullptr);
+    CHECK_OK(f.sch.reject_unsampled(next,RAD_E_IO));CHECK(!f.kv.has_sequence(next));
+    CHECK(f.sch.find(next)->finish_reason=="storage");
