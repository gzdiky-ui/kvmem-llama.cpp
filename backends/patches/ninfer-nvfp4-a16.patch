+        return static_cast<float>(mantissa) * (1.0F / 1024.0F);
+    }
+    float pow2 = 1.0F;
+    for (unsigned i = 0u; i < exponent; ++i) { pow2 *= 2.0F; }
+    // ldexp(1 + man/8, exp - 7) / 2
+    return pow2 * (1.0F / 256.0F) * (1.0F + static_cast<float>(mantissa) / 8.0F);
