+            decode_nvfp4_e2m1x2_raw(static_cast<std::uint8_t>((codes >> (8 * i)) & 0xFFu));
+        union {
+            __nv_bfloat162 pair;
+            unsigned bits;
+        } result;
+        result.pair = __floats2bfloat162_rn(values.x * multiplier, values.y * multiplier);
+        out[i] = result.bits;
+    }
+#endif
+}
