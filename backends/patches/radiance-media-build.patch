+  set_property(SOURCE ${CMAKE_CURRENT_SOURCE_DIR}/mm/media.cpp APPEND
+               PROPERTY INCLUDE_DIRECTORIES ${RAD_FFMPEG_INCLUDE_DIRS})
+  set_property(SOURCE ${CMAKE_CURRENT_SOURCE_DIR}/mm/media.cpp APPEND
+               PROPERTY COMPILE_OPTIONS ${RAD_FFMPEG_CFLAGS_OTHER})
+  target_link_libraries(rad_core PUBLIC ${RAD_FFMPEG_LINK_LIBRARIES})
