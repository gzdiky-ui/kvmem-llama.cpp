+
+    // ---- norm half: the D=5120 unit-offset launcher's ownership, order, reduction and rounding ----
+    const std::int64_t row_base = static_cast<std::int64_t>(token) * kPairsPerRow;
+    __nv_bfloat162 values[kPairsPerThread];
+    __nv_bfloat162 weights[kPairsPerThread];
+    float sum = 0.0F;
+#pragma unroll
+    for (int k = 0; k < kPairsPerThread; ++k) {
+        const int pair = tid + k * fused_detail::kBlock;
+        values[k]      = residual[row_base + pair];
+        weights[k]     = norm_weight[pair];
+        const float2 xf = __bfloat1622float2(values[k]);
+        sum += xf.x * xf.x + xf.y * xf.y;
+    }
+
+    __shared__ float warp_sums[fused_detail::kBlock / kWarpSize];
+    __shared__ float inv_shared;
+    const float block_sum = block_reduce_sum<fused_detail::kBlock>(sum, warp_sums);
+    if (tid == 0) {
+        inv_shared = rsqrtf(block_sum / static_cast<float>(K) + eps);
+    }
+    __syncthreads();
+    const float inv = inv_shared;
+
+    // The exact BF16 image the standalone quantiser would have read back from the global `h`.
+    __shared__ alignas(32) __nv_bfloat16 staged[K];
+#pragma unroll
+    for (int k = 0; k < kPairsPerThread; ++k) {
+        const int pair    = tid + k * fused_detail::kBlock;
+        const float2 xf   = __bfloat1622float2(values[k]);
+        const float2 wf   = __bfloat1622float2(weights[k]);
+        reinterpret_cast<__nv_bfloat162*>(staged)[pair] = __floats2bfloat162_rn(
+            rmsnorm_epilogue<RmsEpilogue::Offset>(xf.x, inv, wf.x, 0.0F),
+            rmsnorm_epilogue<RmsEpilogue::Offset>(xf.y, inv, wf.y, 0.0F));
+    }
+    __syncthreads();
+
+    // ---- quantise half: the shared per-32 group function, reading the staged image ----
+    for (int g = tid; g < kGroups; g += fused_detail::kBlock) {
+        float scale = 0.0F;
+        uint4 packed[2];
+        nvfp4_int8_quantize_group(reinterpret_cast<const uint4*>(staged + g * 32), scale, packed);
+        scales[static_cast<std::size_t>(token) * kGroups + g] = scale;
+        std::int8_t* dst = codes + static_cast<std::size_t>(token) * K + g * 32;
+        reinterpret_cast<uint4*>(dst)[0] = packed[0];
+        reinterpret_cast<uint4*>(dst)[1] = packed[1];
+    }
+}
+
+// The GDN output projection's input is not a plain RMSNorm row: it is a per-head norm with a SiLU
+// gate, `rmsnorm_warp_bf16x2_kernel<Gated, Block, Prefetch>`, where one warp owns one 128-wide head
+// row and reduces with warp shuffles. The block size and the prefetch flag are scheduling choices
+// (the kernel's own comment says so), so this pass is free to pick its own; what it may not change
+// is the per-row ownership, the k-ascending `sum += xf.x * xf.x + xf.y * xf.y` order inside the
+// four-trip window, `rsqrtf(sum / 128 + eps)`, and the single `__floats2bfloat162_rn` rounding of
+// `rmsnorm_epilogue<Gated>`. Those are reproduced here verbatim, and the resulting BF16 image lands
+// in shared memory instead of in the global `on` buffer, from which the same shared per-32 group
+// function writes the two planes.
+//
+// One block per addressed token: a warp takes the head rows whose index is congruent to it, so the
+// token's whole K-wide row is staged before any group is quantised. Group ownership is free (groups
+// are independent of each other and of the reduction), which is what lets one block shape serve both
+// halves.
+template <int K, int D, int Block>
+__launch_bounds__(Block) __global__
+    void gated_rmsnorm_int8_quantize_kernel(const __nv_bfloat162* __restrict__ source,
+                                            const __nv_bfloat162* __restrict__ norm_weight,
+                                            const __nv_bfloat162* __restrict__ gate,
+                                            std::int8_t* __restrict__ codes, float* __restrict__ scales,
+                                            std::int32_t tokens, float eps) {
+    constexpr int kHeads            = K / D;
+    constexpr int kWarps            = Block / kWarpSize;
+    constexpr int kHeadsPerWarp     = kHeads / kWarps;
+    constexpr int kPairs            = D / 2;
+    constexpr int kMaxPairsPerLane  = 4;   // the standalone kernel's window
+    constexpr int kGroups           = K / 32;
+    static_assert(kHeads % kWarps == 0, "head rows must divide across the block's warps");
+    static_assert((D % 64) == 0, "the four-trip window covers D up to 256");
+
+    const std::int32_t token = static_cast<std::int32_t>(blockIdx.x);
+    if (token >= tokens) {
+        // Block-cooperative, like the standalone quantiser's own tail path.
+        zero_nvfp4_int8_activation_row(codes, scales, token, K, kGroups);
+        return;
+    }
+    const int lane = static_cast<int>(threadIdx.x) & (kWarpSize - 1);
+    const int warp = static_cast<int>(threadIdx.x) / kWarpSize;
+
+    __shared__ alignas(32) __nv_bfloat16 staged[K];
+    // A token's row is the whole K-wide span (kPairs is the *head's* pair count), so the token
+    // stride is K/2 pairs -- the first token cannot tell the two apart, which is why a wrong stride
+    // here only shows up from T=2 on.
+    const std::int64_t row0 =
+        static_cast<std::int64_t>(token) * (K / 2);
+#pragma unroll
+    for (int h = 0; h < kHeadsPerWarp; ++h) {
+        const int  head  = warp + h * kWarps;
+        const auto base  = row0 + static_cast<std::int64_t>(head) * kPairs;
+        __nv_bfloat162 values[kMaxPairsPerLane];
+        __nv_bfloat162 weights[kMaxPairsPerLane];
+        __nv_bfloat162 gates[kMaxPairsPerLane];
+        float sum = 0.0f;
+#pragma unroll
+        for (int k = 0; k < kMaxPairsPerLane; ++k) {
+            const int pair = lane + k * kWarpSize;
+            if (pair < kPairs) {
+                values[k] = source[base + pair];
+                weights[k] = norm_weight[pair];
+                gates[k]   = gate[base + pair];
+                const float2 xf = __bfloat1622float2(values[k]);
+                sum += xf.x * xf.x + xf.y * xf.y;
+            }
+        }
+        sum       = warp_reduce_sum(sum);
+        float inv = lane == 0 ? rsqrtf(sum / static_cast<float>(D) + eps) : 0.0f;
+        inv       = __shfl_sync(kFullWarpMask, inv, 0);
+#pragma unroll
+        for (int k = 0; k < kMaxPairsPerLane; ++k) {
+            const int pair = lane + k * kWarpSize;
+            if (pair < kPairs) {
+                const float2 xf = __bfloat1622float2(values[k]);
+                const float2 wf = __bfloat1622float2(weights[k]);
+                const float2 zf = __bfloat1622float2(gates[k]);
+                reinterpret_cast<__nv_bfloat162*>(staged)[
+                    static_cast<std::size_t>(head) * kPairs + pair] = __floats2bfloat162_rn(
+                    rmsnorm_epilogue<RmsEpilogue::Gated>(xf.x, inv, wf.x, zf.x),
+                    rmsnorm_epilogue<RmsEpilogue::Gated>(xf.y, inv, wf.y, zf.y));
+            }
+        }
+    }
+    __syncthreads();
+
+    const std::int32_t tid = static_cast<std::int32_t>(threadIdx.x);
+    for (int g = tid; g < kGroups; g += Block) {
+        float scale = 0.0F;
+        uint4 packed[2];
+        nvfp4_int8_quantize_group(reinterpret_cast<const uint4*>(staged + g * 32), scale, packed);
+        scales[static_cast<std::size_t>(token) * kGroups + g] = scale;
+        std::int8_t* dst = codes + static_cast<std::size_t>(token) * K + g * 32;
+        reinterpret_cast<uint4*>(dst)[0] = packed[0];
+        reinterpret_cast<uint4*>(dst)[1] = packed[1];
+    }
+}
+
+// The host-callable launchers live in nvfp4_int8_fused_norm_quant.cu / .h, so that a route or a
+// test can reach the pass without pulling warp intrinsics into a C++ compile.
+
+} // namespace ninfer::ops::detail::unified
diff --git a/src/ops/linear/nvfp4/nvfp4_int8_fused_norm_quant.h b/src/ops/linear/nvfp4/nvfp4_int8_fused_norm_quant.h
new file mode 100644
index 0000000000000000000000000000000000000000..a2aeb2a1fcd8908698200416cc63f50de3cb0f47
--- /dev/null
+++ b/src/ops/linear/nvfp4/nvfp4_int8_fused_norm_quant.h
@@ -0,0 +1,45 @@
+#pragma once
+
+// Host-facing entry points for the fused [RMSNorm -> int8 quantise] edge of the NVFP4 int8 chain.
+//
+// The device half lives in nvfp4_int8_fused_norm_quant.cuh; this header exists so a host
+// translation unit (a route launcher, a test) can call the pass without pulling warp intrinsics
+// into a C++ compile. See the .cuh for the bit-for-bit contract this preserves.
+
+#include "core/tensor.h"
+
+#include <cuda_runtime.h>
+
+#include <cstdint>
+
+namespace ninfer::ops::detail::unified {
+
+/// Fill the separated int8 activation planes (codes, scales) with the RMSNorm of `residual`
+/// quantised per 32 columns, in one launch. `addressed` is the width the consuming mainloop
+/// addresses -- the padded token tile above the crossover, the call's own width in the narrow band
+/// -- because a plane sized for columns the quantiser never filled is read back uninitialised.
+/// Requires `residual.ne[0] == 5120` and rows/planes sized for `addressed`.
+void launch_rmsnorm_int8_quantize(const Tensor& residual, const Tensor& norm_weight, float eps,
+                                  std::int8_t* codes, float* scales, std::int32_t addressed,
+                                  cudaStream_t stream);
+
+/// The GDN output projection's edge: a per-head SiLU-gated RMSNorm (the shape
+/// `gated_rmsnorm` produces for the 27B: 48 head rows of 128) followed by the same per-32 int8
+/// quantise, in one launch, without the BF16 `on` plane ever going to global memory. Same
+/// pass above. Instantiated for the (6144, 128) geometry only; anything else throws rather than
+/// routing through a kernel that was not sized for it. `source` and `gate` may be the model layer's
+/// 3-D per-head view {128, 48, T} or the flat {6144, T}; either way their memory must be the token's
+/// K-wide row, so the caller names the token count instead of it being read off `ne[1]`.
+void launch_gated_rmsnorm_int8_quantize(const Tensor& source, const Tensor& norm_weight,
+                                        const Tensor& gate, float eps, std::int8_t* codes,
+                                        float* scales, std::int32_t tokens, std::int32_t addressed,
+                                        cudaStream_t stream);
+
+/// The standalone per-32 quantiser over an already-normalised BF16 row, host-callable. This is the
+/// second half of the two launches the fused pass replaces, kept reachable so the fused route can
+/// be byte-compared against the composition it is claiming to equal.
+void launch_nvfp4_int8_quantize32(const void* x, std::int32_t tokens, std::int32_t k,
+                                  std::int8_t* codes, float* scales, std::int32_t addressed,
+                                  cudaStream_t stream);
+
+} // namespace ninfer::ops::detail::unified
diff --git a/src/ops/linear/nvfp4/nvfp4_int8_grouped.cu b/src/ops/linear/nvfp4/nvfp4_int8_grouped.cu
new file mode 100644
index 0000000000000000000000000000000000000000..2b03236046b908cdba370f6cf291dbe5d1ccf8f8
--- /dev/null
+++ b/src/ops/linear/nvfp4/nvfp4_int8_grouped.cu
@@ -0,0 +1,108 @@
+// The plain Linear int8-grouped route: identity rows over any registered NVFP4 geometry. A whole
+// 128-token tile is what the mainloop addresses, so a width that is not one is served by padding the
+// last tile and dropping its surplus columns -- the route answers for every positive token count.
+// Shares the mainloop with the linear_add, attn/gdn input-projection and SwiGLU routes via
+// nvfp4_int8_grouped_mma.cuh; this file adds the instantiation and the shape-checked launcher.
+
+#include "core/device.h"
+#include "core/weight.h"
+#include "ops/linear/common/output.cuh"
+#include "ops/linear/nvfp4/nvfp4_format.h"
+#include "ops/linear/nvfp4/nvfp4_int8_grouped_mma.cuh"
+#include "ops/linear/nvfp4/nvfp4_int8_narrow_launch.cuh"
+#include "ops/linear/nvfp4/nvfp4_mmq_launch.cuh"
+#include "ops/linear/nvfp4/nvfp4_mmvq_launch.cuh"
+#include "ops/linear/nvfp4/nvfp4_shapes_unified.h"
+
+#include <cuda_bf16.h>
+
+#include <stdexcept>
+
+namespace ninfer::ops::detail::unified {
+
+bool nvfp4_linear_int8_tokens_supported(std::int32_t min_tokens, std::int32_t max_tokens) {
+    if (min_tokens <= 0 || max_tokens < min_tokens) { return false; }
+    if (min_tokens == max_tokens) { return nvfp4_int8_route_admits(min_tokens); }
+    return nvfp4_int8_route_interval_admits(min_tokens, max_tokens);
+}
+
+void nvfp4_linear_int8_grouped_launch(const Tensor& x, const Weight& weight, Tensor& out,
+                                      WorkspaceArena& workspace, cudaStream_t stream) {
+    const std::int32_t tokens = x.ne[1];
+    // Plain Linear's int8 route is registered by the unified shape table only, so this call has no
+    // table parameter to consult: the grouped table is its answer and every selection below reads it.
+    // The narrow kernel takes that table literally -- its columns are the call's width, so the planes
+    // are the call's rows and never rounded to the wide mainloop's 128-token tile.
+    constexpr Nvfp4Int8Mainloop table = Nvfp4Int8Mainloop::Grouped;
+    const bool narrow_route = narrow::select(tokens, table);
+    const std::int32_t padded = narrow::addressed_tokens(tokens, table);
+    if (weight.qtype != QType::NVFP4 || weight.layout != QuantLayout::BlockScaleK16M128x4 ||
+        weight.group != 16 || weight.n <= 0 || weight.n % 128 || weight.k <= 0 || weight.k % 64 ||
+        weight.qdata == nullptr || weight.scales == nullptr ||
+        !nvfp4_int8_route_admits(tokens)) {
+        throw std::invalid_argument("nvfp4 linear int8: unsupported profile");
+    }
+    (void)validate_nvfp4_weight(weight, "nvfp4 linear int8");
+
+    auto scope = workspace.scope();
+    // The two routes quantise the same activations but lay the plane out differently: the MMQ
+    // mainloop consumes one interleaved plane (four FP32 scales then 128 s8 codes per token per
+    // 128-column window), the grouped mainloop the two separated planes. Both cost K + K/8 bytes
+    // per token, so the workspace the plan declared covers either. The grouped planes are sized for
+    // the padded width because that is the width the mainloop addresses.
+    // A test override can still drive MMQ through this route, which is why the wide selections read
+    // the same local the narrow one does rather than a literal.
+    const bool mmq_route  = mmq::select(weight.k, tokens, table);
+    // Below the crossover the MMVQ-shaped mainloop reads these same two planes, so it needs no
+    // second quantisation pass and none of the interleaved form's routing.
+    const bool mmvq_route = mmvq::select(tokens);
+    DeviceSpan codes;
+    DeviceSpan scales;
+    if (mmq_route) {
+        codes = workspace.alloc_bytes(mmq::activation_bytes(tokens, weight.k));
+    } else {
+        codes  = workspace.alloc_bytes(static_cast<std::size_t>(padded) * weight.k);
+        scales = workspace.alloc_bytes(static_cast<std::size_t>(padded) * (weight.k / 32) *
+                                       sizeof(float));
+    }
+    if (mmq_route) {
+        mmq::quantize_activations(x.data, tokens, weight.k, codes.data, stream);
+    } else {
+        quantize_nvfp4_int8_grouped<<<padded, 128, 0, stream>>>(
+            reinterpret_cast<const __nv_bfloat16*>(x.data), tokens, weight.k,
+            reinterpret_cast<std::int8_t*>(codes.data), reinterpret_cast<float*>(scales.data));
+    }
+
+    const LinearBf16Output output{static_cast<__nv_bfloat16*>(out.data), weight.n};
+    const auto* w_codes  = static_cast<const std::uint8_t*>(weight.qdata);
+    const auto* w_scales = static_cast<const std::uint8_t*>(weight.scales);
+    const auto* x_int8   = reinterpret_cast<const std::int8_t*>(codes.data);
+    const auto* x_scale  = reinterpret_cast<const float*>(scales.data);
+    const float alpha    = 1.0F / weight.weight_scale_divisor;
+    if (mmvq_route) {
+        if (narrow_route) {
+            narrow::launch<LinearBf16Output>(w_codes, w_scales, x_int8, x_scale, alpha, output,
+                                             weight.k, tokens, weight.n, stream);
+        } else {
+            mmvq::launch<LinearBf16Output>(w_codes, w_scales, x_int8, x_scale, alpha, output,
+                                           weight.k, tokens, weight.n, stream);
+        }
+        CUDA_CHECK(cudaGetLastError());
+        return;
+    }
+    if (mmq_route) {
+        mmq::launch<LinearBf16Output>(w_codes, w_scales, x_int8, alpha, output, weight.k, tokens,
+                                      weight.n, stream);
+        CUDA_CHECK(cudaGetLastError());
+        return;
+    }
+    // alpha = 1/weight_scale_divisor: the E2M1 1/2 already folded into the E4M3 scale decode, where
+    // llama.cpp folds it too -- the same for every route on this mainloop. Both int8 mainloops take
+    // the caller's real token count and predicate their stores on it, so the surplus columns a padded
+    // tile computes are dropped rather than written.
+    nvfp4_int8_grouped_launch<LinearBf16Output>(w_codes, w_scales, x_int8, x_scale, alpha, output,
+                                                weight.k, tokens, weight.n, stream);
+    CUDA_CHECK(cudaGetLastError());
+}
+
+} // namespace ninfer::ops::detail::unified
diff --git a/src/ops/linear/nvfp4/nvfp4_int8_grouped_host.h b/src/ops/linear/nvfp4/nvfp4_int8_grouped_host.h
new file mode 100644
index 0000000000000000000000000000000000000000..222e116b6bf878a83786f6f717edb57a18f0c311
--- /dev/null
+++ b/src/ops/linear/nvfp4/nvfp4_int8_grouped_host.h
@@ -0,0 +1,136 @@
+#pragma once
+
+// Host-side arithmetic for the NVFP4 Tier-2 int8-grouped route (see nvfp4_int8_grouped_mma.cuh
+// for the device side and the performance model). Kept separate from the .cuh so plan and
+// dispatch translation units -- which the MSVC host compiler builds -- can query admission and
+// workspace sizes without pulling in device intrinsics.
+//
+// Width is not an admission question: the family answers every positive width, and both
+// wide mainloops serve it by padding their last token tile (nvfp4_int8_padded_tokens) instead of
+// refusing it. Which wide mainloop that is belongs to the route table (nvfp4_int8_route.h);
+// admission looks only at whether the family is registered for the call.
+//
+// The token tile is itself a function of the call width now. Every mainloop here issues one MMA per
+// (16 output rows, 8 tokens, 16 k) tile, so with a fixed 128-token tile a single-token call pays for
+// 128 tokens' worth of tensor-core work while reading the same weight bytes once -- and if the tile
+// were merely relabelled without changing how many of them a call launches, a small J would instead
+// re-read the weights once per tile column. nvfp4_int8_select_j therefore picks the largest admitted
+// tile that still covers the width, and both grid and padding follow it, so every call reads each
+// weight element exactly once no matter how narrow it is; surplus tile columns are computed and
+// discarded by the epilogue guard rather than launched.
+
+#include "ops/linear/nvfp4/nvfp4_int8_route.h"
+
+#include <cstddef>
+#include <cstdint>
+
+namespace ninfer::ops::detail::unified {
+
+// Shared launch geometry. BM=BN=128, BK=64 (exactly four G16 weight groups per k-tile), 16 bytes
+// of smem row padding to keep every lds128 word-aligned without a 128-multiple stride. The CTA is
+// 256 threads / 8 warps (ggml-MMQ shaped): 256 * 255 regs stays under the SM's 64K register file
+// with room to hoist the A operands for the whole k-tile, which the old 512-thread CTA (512 * 128
+// = the whole file) could not.
+namespace detail {
+
+constexpr int kInt8TileRows    = 128; // BM
+constexpr int kInt8TileTokens  = 128; // BN
+constexpr int kInt8TileK       = 64;  // BK, exactly four G16 groups
+constexpr int kInt8SRow        = kInt8TileK + 16;
+constexpr int kInt8Threads     = 256;
+constexpr int kInt8ScaleGroups = 4; // weight group scales per row per k-tile
+constexpr int kInt8XScales     = 2; // per-32 activation scales per row per k-tile
+
+} // namespace detail
+
+constexpr int nvfp4_int8_grouped_smem_bytes() {
+    // Two buffer sets: the mainloop stages tile t+1 while it computes tile t, which is what buys the
+    // single barrier per tile. The activation half is sized for BM rows although a stage only holds
+    // BN <= BM of them, so one launch size covers every slide of the token-tile ladder.
+    return 2 * detail::kInt8TileRows * detail::kInt8SRow * 2 +                 // sa + sb, double buffered
+           2 * detail::kInt8TileRows * detail::kInt8ScaleGroups * sizeof(float) + // sws
+           2 * detail::kInt8TileRows * detail::kInt8XScales * sizeof(float) +     // sxs
+           256 * sizeof(float);                                                   // E4M3 scale table
+}
+
+// Token-tile ladder. Both mainloops are templated on J from this set, which is ggml's Ampere NVFP4
+// column set intersected with ours (mmq-config-ampere.cuh's fallback=false row, plus the multiples of
+// eight in between that its rows_per_warp rule also covers). 8 is the floor because an MMA column
+// tile is 8 tokens wide -- below it there is nothing smaller to buy, and below it the MMVQ-shaped
+// kernel takes over (nvfp4_mmvq_host.h).
+// ggml's Ampere NVFP4 column set (mmq-config-ampere.cuh's non-fallback row), ascending. It is not
+// "every multiple of eight": 56, 72, 88, 104 and 120 have no row upstream, and a stage that no
+// translation unit instantiates is a launch that throws. The set is what both dispatch switches are
+// written over, so adding one here means adding it there.
+constexpr int kInt8TileStages[] = {8, 16, 24, 32, 40, 48, 64, 80, 96, 112, 128};
+constexpr int kInt8TileStageCount = sizeof(kInt8TileStages) / sizeof(kInt8TileStages[0]);
+constexpr int kInt8MinTileTokens = kInt8TileStages[0];
+constexpr int kInt8MaxTileTokens = kInt8TileStages[kInt8TileStageCount - 1];
+
+constexpr bool nvfp4_int8_j_admitted(int j) {
+    for (int stage : kInt8TileStages) {
+        if (stage == j) { return true; }
+    }
+    return false;
+}
+
+// The token tile a call of `tokens` columns stages: the smallest stage covering the width, capped at
+// 128 -- above the cap a call is served by several whole tiles.
+constexpr int nvfp4_int8_select_j(std::int32_t tokens) {
+    if (tokens <= 0) { return 0; }
+    const int capped = tokens > kInt8MaxTileTokens ? kInt8MaxTileTokens : static_cast<int>(tokens);
+    for (int stage : kInt8TileStages) {
+        if (stage >= capped) { return stage; }
+    }
+    return kInt8MaxTileTokens;
+}
+
+// The token count a padded launch actually runs. The mainloop has no predicated tail -- its grid is
+// one CTA per whole J-token tile and every one of its J activation rows is read -- so a width that is
+// not a whole tile is served by running the tile full and discarding the surplus: the quantiser
+// zeroes the padding rows' planes instead of reading activations that do not exist, and the epilogue
+// stores only the tokens the caller asked for.
+constexpr std::int32_t nvfp4_int8_padded_tokens(std::int32_t tokens) {
+    const int j = nvfp4_int8_select_j(tokens);
+    return tokens <= 0 ? 0
+                       : ((tokens + j - 1) / j) * j;
+}
+
+// Width admission of the int8 *family*: every positive width is answered -- the MMA mainloops pad
+// rather than refuse above the crossover, and the MMVQ-shaped row-form kernel takes T <= 8 on top
+// of whichever wide mainloop the table selected (mmvq::applies). This is a family question, not a
+// mainloop question: the label a plan declares is decided here, so it stays `Int8Grouped` at narrow
+// widths even though the row-form kernel is what runs there. Whether the family is registered at
+// all is the model layer's decision (--nvfp4-w4a8-int), not a property of a width.
+inline bool nvfp4_int8_route_admits(std::int32_t tokens) { return tokens >= 1; }
+
+// The same question for a [min,max] planning interval: can any width in it reach the int8 kernels?
+inline bool nvfp4_int8_route_interval_admits(std::int32_t min_tokens, std::int32_t max_tokens) {
+    return min_tokens >= 1 && max_tokens >= min_tokens;
+}
+
+// s8 codes [T][K] plus the FP32 per-(token,32) scale plane [T][K/32], each 256-aligned by the arena,
+// at a width that is already the width the launch addresses. The tile-padded route reaches it through
+// `nvfp4_int8_grouped_workspace_bytes` below; the narrow band's sizing calls it directly, because for
+// it the call's own width IS the width the kernel addresses.
+//
+// The MMQ mainloop reads the same quantisation interleaved instead -- per token, per 128-column
+// window, four FP32 scales then 128 s8 codes, 144 bytes -- which is the same K + K/8 bytes per
+// token as one contiguous span rather than two 256-aligned ones, so it never exceeds this envelope.
+// mmq::activation_bytes() is what that route allocates, and it is checked against this function
+// for every T in nvfp4_int8's workspace-envelope test.
+constexpr std::size_t nvfp4_int8_plane_bytes(std::int32_t addressed_tokens, std::int32_t k) {
+    const std::size_t t      = static_cast<std::size_t>(addressed_tokens);
+    const std::size_t groups = static_cast<std::size_t>(k) / 32;
+    return ((t * static_cast<std::size_t>(k) + 255) / 256) * 256 +
+           ((t * groups * sizeof(float) + 255) / 256) * 256;
+}
+
+// The same two planes for a tile-padded launch: sized for the PADDED token count, because that is
+// what the launch addresses. An exact whole-tile width is unchanged by this, and a ragged one is
+// covered by the pad rather than by the count of its own tokens.
+constexpr std::size_t nvfp4_int8_grouped_workspace_bytes(std::int32_t tokens, std::int32_t k) {
+    return nvfp4_int8_plane_bytes(nvfp4_int8_padded_tokens(tokens), k);
+}
+
+} // namespace ninfer::ops::detail::unified
