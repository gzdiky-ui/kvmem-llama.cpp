@@ -0,0 +1,372 @@
+// The int8-grouped wrapper routes against real artifact weights: the QUASAR-NVFP4 fused
+// attention / GDN parents, the down projection and the two output projections, exactly as the
+// artifact stores them. The synthetic suites exercise the same kernels over patterned fixtures;
+// real weights carry the divisor and value-range distribution the artifact actually ships, which
+// is what the model-level PPL probes measure.
+//
+// The fixture is generated by tests/fixtures/nvfp4_int8_real/generate_fixture.py and its path is
+// read from NINFER_NVFP4_INT8_REAL_FIXTURE. Without it the test skips.
+
+#include "core/weight.h"
+#include "ninfer/ops/attn_input_proj.h"
+#include "ninfer/ops/gdn_input_proj.h"
+#include "ninfer/ops/linear_add.h"
+
+#include "ops/input_projection_test_common.h"
+#include "ops/linear/common/route_table.h"
+#include "ops/op_tester.h"
+
+#include <cuda_runtime.h>
+
+#include <cmath>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <fstream>
+#include <iostream>
+#include <map>
+#include <optional>
+#include <string>
+#include <vector>
+
+using namespace ninfer;
+using namespace ninfer::test;
+using namespace ninfer::test::input_projection;
+
+namespace {
+
+// The route the engine's device profile selects for these fused Ops at prefill widths; this
+// binary installs no profile, so force it for the duration of the run.
+struct UnifiedRoutes {
+    UnifiedRoutes() { ops::detail::force_linear_route_table(ops::detail::LinearRouteTable::Unified); }
+    ~UnifiedRoutes() { ops::detail::force_linear_route_table(std::nullopt); }
+};
+
+// Both operands integer-quantized: the A8 allowance the synthetic suites hold the route to.
+constexpr ReductionCriterion kInt8Tolerance{0.04, 1.0 / 256.0, 0.06};
+
+float e2m1_value(unsigned nibble) {
+    static constexpr float kMagnitudes[8]{0.0F, 0.5F, 1.0F, 1.5F, 2.0F, 3.0F, 4.0F, 6.0F};
+    const float magnitude = kMagnitudes[nibble & 7U];
+    return (nibble & 8U) ? -magnitude : magnitude;
+}
+
+float e4m3_value(unsigned byte) {
+    const unsigned sign     = byte & 0x80U;
+    const unsigned exponent = (byte >> 3) & 0xFU;
+    const unsigned mantissa = byte & 7U;
+    if (exponent == 0 && mantissa == 0) { return 0.0F; }
+    if (exponent == 15 && mantissa == 7) { return std::nanf(""); }
+    const float magnitude =
+        exponent == 0
+            ? static_cast<float>(mantissa) * (1.0F / 512.0F)
+            : std::ldexp(1.0F + static_cast<float>(mantissa) / 8.0F, static_cast<int>(exponent) - 7);
+    return sign ? -magnitude : magnitude;
+}
+
+// One stored NVFP4 parent: E2M1 codes, the BlockScaleK16M128x4 scale plane, and the trailing
+// FP32 weight divisor, byte-identical to the artifact object.
+struct FixtureWeight {
+    std::string name;
+    std::int32_t n = 0;
+    std::int32_t k = 0;
+    std::vector<std::uint8_t> payload;
+    float divisor = 0.0F;
+
+    std::size_t scale_offset() const {
+        const std::uint64_t code_bytes = static_cast<std::uint64_t>(n) * k / 2;
+        return static_cast<std::size_t>((code_bytes + 255) / 256) * 256;
+    }
+
+    // Independent decode: value = e2m1 * e4m3_group_scale / divisor.
+    double logical(std::int32_t row, std::int32_t column) const {
+        const std::size_t code_index = static_cast<std::size_t>(row) * k / 2 + column / 2;
+        const std::uint8_t byte      = payload[code_index];
+        const unsigned nibble        = (column % 2) == 0 ? (byte & 0xFU) : (byte >> 4);
+        const std::int32_t group     = column / 16;
+        const std::size_t offset =
+            (static_cast<std::size_t>(row / 128) * (k / 64) + group / 4) * 512U +
+            static_cast<std::size_t>(row & 31) * 16U +
+            static_cast<std::size_t>((row & 127) >> 5) * 4U + static_cast<std::size_t>(group & 3);
+        return static_cast<double>(e2m1_value(nibble) * e4m3_value(payload[scale_offset() + offset])) /
+               divisor;
+    }
+};
+
+std::map<std::string, FixtureWeight> load_fixture(const char* path) {
+    std::ifstream stream(path, std::ios::binary);
+    if (!stream) { throw std::runtime_error(std::string("cannot open ") + path); }
+    std::vector<std::uint8_t> bytes((std::istreambuf_iterator<char>(stream)),
+                                    std::istreambuf_iterator<char>());
+    std::size_t cursor = 0;
+    const std::string label_path(path);
+    const auto read = [&bytes, &cursor, &label_path](void* target, std::size_t count) {
+        if (cursor + count > bytes.size()) {
+            throw std::runtime_error(label_path + ": truncated fixture");
+        }
+        std::memcpy(target, bytes.data() + cursor, count);
+        cursor += count;
+    };
+    char magic[4];
+    read(magic, 4);
+    if (std::memcmp(magic, "NVRW", 4) != 0) {
+        throw std::runtime_error(std::string(path) + ": not an NVRW fixture");
+    }
+    std::uint32_t count = 0;
+    read(&count, 4);
+    std::map<std::string, FixtureWeight> entries;
+    for (std::uint32_t index = 0; index < count; ++index) {
+        std::uint32_t name_length = 0;
+        read(&name_length, 4);
+        FixtureWeight entry;
+        entry.name.resize(name_length);
+        read(entry.name.data(), name_length);
+        std::uint64_t payload_bytes = 0;
+        read(&entry.n, 4);
+        read(&entry.k, 4);
+        read(&payload_bytes, 8);
+        entry.payload.resize(payload_bytes);
+        read(entry.payload.data(), payload_bytes);
+        std::memcpy(&entry.divisor, entry.payload.data() + payload_bytes - 4, 4);
+        if (!(entry.divisor > 0.0F) || !std::isfinite(entry.divisor)) {
+            throw std::runtime_error(entry.name + ": invalid weight divisor");
+        }
+        entries.emplace(entry.name, std::move(entry));
+    }
+    return entries;
+}
+
+// The fixture payload is byte-identical to what the engine materializes, so the Weight mirrors
+// native_weight's NVFP4 field assignments (see ops/weight_input.cpp).
+Weight device_weight(const FixtureWeight& entry, void* device_payload) {
+    const std::size_t scale_bytes = static_cast<std::size_t>(entry.n) * entry.k / 16;
+    auto* base                    = static_cast<std::uint8_t*>(device_payload);
+    Weight weight{};
+    weight.qtype                = QType::NVFP4;
+    weight.layout               = QuantLayout::BlockScaleK16M128x4;
+    weight.scale_dtype          = DType::FP8_E4M3FN;
+    weight.payload              = base;
+    weight.payload_bytes        = entry.payload.size();
+    weight.high_plane_bytes     = 0;
+    weight.qdata                = base;
+    weight.qhigh                = nullptr;
+    weight.scales               = base + entry.scale_offset();
+    weight.group_size           = 16;
+    weight.group                = 16;
+    weight.ndim                 = 2;
+    weight.shape[0]             = entry.n;
+    weight.shape[1]             = entry.k;
+    weight.shape[2]             = 1;
+    weight.shape[3]             = 1;
+    weight.padded_shape[0]      = entry.n;
+    weight.padded_shape[1]      = entry.k;
+    weight.padded_shape[2]      = 1;
+    weight.padded_shape[3]      = 1;
+    weight.n                    = entry.n;
+    weight.k                    = entry.k;
+    weight.weight_divisors      = base + entry.scale_offset() + scale_bytes;
+    weight.weight_divisor_rows  = entry.n;
+    weight.weight_scale_divisor = entry.divisor;
+    weight.input_scale_divisor  = 1.0F;
+    return weight;
+}
+
+// Sampled rows of one output segment against the FP64 oracle over the fixture bytes.
+int verify_segment(const std::string& label, const std::vector<double>& actual,
+                   const FixtureWeight& weight, std::int32_t row_begin, std::int32_t rows,
+                   const std::vector<std::uint16_t>& activation_bits, std::int32_t tokens) {
+    std::vector<double> expected;
+    const std::vector<std::int32_t> sampled = sampled_rows(rows, 7);
+    for (const std::int32_t local_row : sampled) {
+        for (std::int32_t token = 0; token < tokens; ++token) {
+            const std::uint16_t* input =
+                activation_bits.data() + static_cast<std::size_t>(token) * weight.k;
+            double sum = 0.0;
+            for (std::int32_t column = 0; column < weight.k; ++column) {
+                sum += weight.logical(row_begin + local_row, column) *
+                       static_cast<double>(bf16_to_f32(input[column]));
+            }
+            expected.push_back(sum);
+        }
+    }
+    return verify_reduction(label.c_str(), actual, expected, kInt8Tolerance);
+}
+
+std::vector<std::uint16_t> make_activation(std::int32_t k, std::int32_t tokens, std::uint32_t seed) {
+    std::vector<std::uint16_t> bits(static_cast<std::size_t>(k) * tokens);
+    for (std::int32_t token = 0; token < tokens; ++token) {
+        for (std::int32_t column = 0; column < k; ++column) {
+            std::uint32_t value = seed ^ (static_cast<std::uint32_t>(column) * 0x9e3779b9U) ^
+                                  (static_cast<std::uint32_t>(token) * 0x85ebca6bU);
+            value ^= value >> 16;
+            value *= 0x7feb352dU;
+            value ^= value >> 15;
+            const float represented =
+                static_cast<float>(static_cast<int>(value & 0x3ffU) - 512) * (1.0F / 512.0F);
+            bits[static_cast<std::size_t>(token) * k + column] = f32_to_bf16(represented);
+        }
+    }
+    return bits;
+}
+
+std::vector<std::uint16_t> make_residual(std::int32_t n, std::int32_t tokens, std::uint32_t seed) {
+    std::vector<std::uint16_t> bits(static_cast<std::size_t>(n) * tokens);
+    for (std::size_t index = 0; index < bits.size(); ++index) {
+        const std::uint32_t hash       = index * 2654435761U + seed;
+        const float represented        = static_cast<float>(static_cast<int>(hash & 0xffU) - 128) *
+                                  (1.0F / 128.0F);
+        bits[index]                    = f32_to_bf16(represented);
+    }
+    return bits;
+}
+
+int run_attention(const FixtureWeight& entry, std::int32_t tokens) {
+    constexpr std::int32_t kHidden = 5120, kQRows = 6144, kKvRows = 1024;
+    const std::vector<std::uint16_t> activation = make_activation(kHidden, tokens, 911U);
+    DeviceBuffer input                          = to_device(activation);
+    DeviceBuffer weight_buffer                  = to_device(entry.payload);
+    const Weight weight                         = device_weight(entry, weight_buffer.p);
+
+    GuardedBf16Tensor query(kQRows, tokens), gate(kQRows, tokens), key(kKvRows, tokens),
+        value(kKvRows, tokens);
+    Tensor x(input.p, DType::BF16, {kHidden, tokens});
+    Tensor q = query.tensor(), g = gate.tensor(), k = key.tensor(), v = value.tensor();
+    const std::size_t capacity = ops::attn_input_proj_workspace_capacity_bytes(
+        QType::NVFP4, entry.n, kHidden, ops::LinearPolicy::AllowNvfp4Int8, tokens, tokens);
+    WorkspaceArena workspace(std::max<std::size_t>(capacity, 256));
+    ops::attn_input_proj(x, weight, q, g, k, v, ops::LinearPolicy::AllowNvfp4Int8, workspace,
+                         nullptr);
+    cuda_synchronize();
+
+    const std::string suffix =
+        " attn [" + std::to_string(entry.n) + "," + std::to_string(entry.k) +
+        "] T=" + std::to_string(tokens);
+    int failures = query.verify_guards("attn q" + suffix);
+    failures += gate.verify_guards("attn gate" + suffix);
+    failures += key.verify_guards("attn k" + suffix);
+    failures += value.verify_guards("attn v" + suffix);
+    // Fused parent rows: query [0,6144), key [6144,7168), gate [7168,13312), value [13312,14336).
+    failures += verify_segment("attn q" + suffix,
+                               gather_rows(query.values(), kQRows, 0, kQRows, tokens), entry, 0,
+                               kQRows, activation, tokens);
+    failures += verify_segment("attn k" + suffix,
+                               gather_rows(key.values(), kKvRows, 0, kKvRows, tokens), entry,
+                               kQRows, kKvRows, activation, tokens);
+    failures += verify_segment("attn gate" + suffix,
+                               gather_rows(gate.values(), kQRows, 0, kQRows, tokens), entry,
+                               kQRows + kKvRows, kQRows, activation, tokens);
+    failures += verify_segment("attn v" + suffix,
+                               gather_rows(value.values(), kKvRows, 0, kKvRows, tokens), entry,
+                               kQRows + kKvRows + kQRows, kKvRows, activation, tokens);
+    return failures;
+}
+
+int run_gdn(const FixtureWeight& entry, std::int32_t tokens) {
+    constexpr std::int32_t kHidden = 5120, kQkvRows = 10240, kZRows = 6144;
+    const std::vector<std::uint16_t> activation = make_activation(kHidden, tokens, 919U);
+    DeviceBuffer input                          = to_device(activation);
+    DeviceBuffer weight_buffer                  = to_device(entry.payload);
+    const Weight weight                         = device_weight(entry, weight_buffer.p);
+
+    GuardedBf16Tensor qkv(kQkvRows, tokens), z(kZRows, tokens);
+    Tensor x(input.p, DType::BF16, {kHidden, tokens});
+    Tensor qkv_out = qkv.tensor(), z_out = z.tensor();
+    const std::size_t capacity = ops::gdn_input_proj_workspace_capacity_bytes(
+        QType::NVFP4, entry.n, kHidden, ops::LinearPolicy::AllowNvfp4Int8, tokens, tokens);
+    WorkspaceArena workspace(std::max<std::size_t>(capacity, 256));
+    ops::gdn_input_proj(x, weight, qkv_out, z_out, ops::LinearPolicy::AllowNvfp4Int8, workspace,
+                        nullptr);
+    cuda_synchronize();
+
+    const std::string suffix =
+        " gdn [" + std::to_string(entry.n) + "," + std::to_string(entry.k) +
+        "] T=" + std::to_string(tokens);
+    int failures = qkv.verify_guards("gdn qkv" + suffix);
+    failures += z.verify_guards("gdn z" + suffix);
+    // Fused parent rows: q [0,2048), k [2048,4096), v [4096,10240), z [10240,16384).
+    failures += verify_segment("gdn q" + suffix,
+                               gather_rows(qkv.values(), kQkvRows, 0, 2048, tokens), entry, 0,
+                               2048, activation, tokens);
+    failures += verify_segment("gdn k" + suffix,
+                               gather_rows(qkv.values(), kQkvRows, 2048, 2048, tokens), entry,
+                               2048, 2048, activation, tokens);
+    failures += verify_segment("gdn v" + suffix,
+                               gather_rows(qkv.values(), kQkvRows, 4096, 6144, tokens), entry,
+                               4096, 6144, activation, tokens);
+    failures += verify_segment("gdn z" + suffix,
+                               gather_rows(z.values(), kZRows, 0, kZRows, tokens), entry, kQkvRows,
+                               kZRows, activation, tokens);
+    return failures;
+}
+
+int run_linear_add(const FixtureWeight& entry, std::int32_t tokens) {
+    const std::vector<std::uint16_t> activation = make_activation(entry.k, tokens, 929U);
+    const std::vector<std::uint16_t> residual   = make_residual(entry.n, tokens, 939U);
+    DeviceBuffer input                          = to_device(activation);
+    DeviceBuffer weight_buffer                  = to_device(entry.payload);
+    const Weight weight                         = device_weight(entry, weight_buffer.p);
+
+    GuardedBf16Tensor output(entry.n, tokens);
+    output.copy_from_bits(residual);
+    Tensor x(input.p, DType::BF16, {entry.k, tokens});
+    Tensor residual_out = output.tensor();
+    const std::size_t capacity = ops::linear_add_workspace_capacity_bytes(
+        QType::NVFP4, entry.n, entry.k, ops::LinearPolicy::AllowNvfp4Int8, tokens, tokens);
+    WorkspaceArena workspace(std::max<std::size_t>(capacity, 256));
+    ops::linear_add(x, weight, residual_out, ops::LinearPolicy::AllowNvfp4Int8, workspace, nullptr);
+    cuda_synchronize();
+
+    const std::string suffix = " linear_add " + entry.name + " T=" + std::to_string(tokens);
+    int failures             = output.verify_guards(suffix);
+    const std::vector<double> actual =
+        gather_rows(output.values(), entry.n, 0, entry.n, tokens, 8);
+    std::vector<double> expected;
+    const std::vector<std::int32_t> sampled = sampled_rows(entry.n, 8);
+    for (const std::int32_t local_row : sampled) {
+        for (std::int32_t token = 0; token < tokens; ++token) {
+            const std::uint16_t* input_row =
+                activation.data() + static_cast<std::size_t>(token) * entry.k;
+            double sum = 0.0;
+            for (std::int32_t column = 0; column < entry.k; ++column) {
+                sum += entry.logical(local_row, column) *
+                       static_cast<double>(bf16_to_f32(input_row[column]));
+            }
+            const std::size_t index = static_cast<std::size_t>(token) * entry.n + local_row;
+            expected.push_back(sum + static_cast<double>(bf16_to_f32(residual[index])));
+        }
+    }
+    failures += verify_reduction(("projection" + suffix).c_str(), actual, expected, kInt8Tolerance);
+    return failures;
+}
+
+} // namespace
+
+int main() {
+    if (cuda_unavailable()) {
+        std::cout << "SKIP: no usable CUDA device\n";
+        return 77;
+    }
+    const char* fixture = std::getenv("NINFER_NVFP4_INT8_REAL_FIXTURE");
+    if (fixture == nullptr) {
+        std::cout << "SKIP: NINFER_NVFP4_INT8_REAL_FIXTURE is not set"
+                  << " (generate with tests/fixtures/nvfp4_int8_real/generate_fixture.py)\n";
+        return 77;
+    }
+    try {
+        const std::map<std::string, FixtureWeight> entries = load_fixture(fixture);
+        const UnifiedRoutes unified;
+        int failures = 0;
+        for (const std::int32_t tokens : {128, 256}) {
+            failures += run_attention(entries.at("attn_fused_14336x5120"), tokens);
+            failures += run_gdn(entries.at("gdn_fused_16384x5120"), tokens);
+            failures += run_linear_add(entries.at("down_5120x17408"), tokens);
+            failures += run_linear_add(entries.at("attn_output_5120x6144"), tokens);
+            failures += run_linear_add(entries.at("gdn_output_5120x6144"), tokens);
+        }
+        std::cout << (failures == 0 ? "OK" : "FAIL") << " NVFP4 int8 real weights\n";
+        return failures == 0 ? 0 : 1;
+    } catch (const std::exception& error) {
+        std::cerr << "NVFP4 int8 real weights: " << error.what() << '\n';
+        return 1;
+    }
+}
