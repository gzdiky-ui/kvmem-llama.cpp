+enum class MappingPattern { Identity, Offset, Fragmented };
+
+const char* mapping_name(MappingPattern pattern) {
+    switch (pattern) {
+    case MappingPattern::Identity:
+        return "identity";
+    case MappingPattern::Offset:
+        return "offset";
+    case MappingPattern::Fragmented:
+        return "fragmented";
