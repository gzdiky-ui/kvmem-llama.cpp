+// NINFER_WIDE_PROGRESS names each wide case on stdout before it runs, so a launch that faults the
+// device (the rest of the run then fails) is tied to its case.
+void wide_progress(const Geometry& geometry, KvCacheStorage storage, const char* kind,
+                   std::int32_t width, std::int64_t base, std::int64_t detail = -1) {
+    static const bool enabled = std::getenv("NINFER_WIDE_PROGRESS") != nullptr;
+    if (!enabled) { return; }
+    std::cout << "wide " << geometry.name << ' ' << cache_name(storage) << ' ' << kind
+              << " width=" << width << " base=" << base;
+    if (detail >= 0) { std::cout << " detail=" << detail; }
+    std::cout << std::endl;
+}
+
+// Copy verification: one request verifies 17..64 columns through the chunked single-row route.
+int run_wide_copy_cases(KvCacheStorage storage) {
+    int failures = 0;
+    for (const Geometry& geometry : kGeometries) {
+        for (std::int32_t width = 17; width <= 64; ++width) {
+            wide_progress(geometry, storage, "batch", width, 127);
+            failures += run_batch_case(geometry, storage,
+                                       {width,
+                                        {127},
+                                        {width},
+                                        {0},
+                                        MappingPattern::Fragmented,
+                                        static_cast<std::uint32_t>(1900 + width),
+                                        true});
+        }
+        for (std::int32_t width : {17, 24, 32, 33, 48, 64}) {
+            for (std::int32_t valid : {0, 1, width - 1, width}) {
+                wide_progress(geometry, storage, "batch", width, 2048, valid);
+                failures += run_batch_case(geometry, storage,
+                                           {width,
+                                            {2048},
+                                            {valid},
+                                            {0},
+                                            MappingPattern::Fragmented,
+                                            static_cast<std::uint32_t>(2000 + width + valid),
+                                            true});
+            }
+            wide_progress(geometry, storage, "a1+a3 wide", width, 8192);
+            failures += run_a1_case(geometry, storage,
+                                    {.tokens            = width,
+                                     .base              = 8192,
+                                     .envelope_max      = static_cast<std::uint32_t>(8192 + width),
+                                     .seed              = 2101u,
+                                     .graph_replay      = true,
+                                     .wide_verification = true},
+                                    MappingPattern::Fragmented);
+            failures += run_a3_case(geometry, storage,
+                                    {.tokens            = width,
+                                     .base              = 8192,
+                                     .envelope_max      = static_cast<std::uint32_t>(8192 + width),
+                                     .seed              = 2102u,
+                                     .graph_replay      = true,
+                                     .wide_verification = true},
+                                    MappingPattern::Fragmented);
+        }
+        // A loose envelope must select the same safe workspace even when device positions are
+        // still inside the prompt-route region. Width 65 remains a prompt operation.
+        for (std::int32_t width : {17, 32, 33, 64, 65}) {
+            for (std::uint32_t maximum : {256u, 257u, 320u, 321u, 640u, 641u, 1024u, 1025u}) {
+                wide_progress(geometry, storage, "a3 loose envelope", width, 31, maximum);
+                failures += run_a3_case(geometry, storage,
+                                        {.tokens            = width,
+                                         .base              = 31,
+                                         .envelope_max      = maximum,
+                                         .seed              = 2103u,
+                                         .wide_verification = true},
+                                        MappingPattern::Offset);
+            }
+        }
+        for (std::int32_t width : {17, 32, 33, 64}) {
+            wide_progress(geometry, storage, "a1 graph", width, 8192);
+            failures += run_a1_case(geometry, storage,
+                                    {.tokens       = width,
+                                     .base         = 8192,
+                                     .envelope_max = static_cast<std::uint32_t>(8192 + width),
+                                     .seed         = 2104u,
+                                     .graph_replay = true},
+                                    MappingPattern::Fragmented);
+        }
+        // Single-row prefill with the small-prefill hint: widths 17-64 over a long context take
+        // chunked small-T, a short context and widths outside 17-64 keep their routes, and the
+        // route threshold (64 or 80 visible keys per row) is crossed from both sides.
+        const std::int32_t keys_per_row = geometry.q_heads == 16 ? 80 : 64;
+        const auto prefill = [](std::int32_t width, std::int32_t base, std::uint32_t seed) {
+            return AttentionCase{.tokens        = width,
+                                 .base          = base,
+                                 .envelope_max  = static_cast<std::uint32_t>(base + width),
+                                 .seed          = seed,
+                                 .small_prefill = true};
+        };
+        for (std::int32_t width : {16, 17, 24, 33, 48, 64, 65}) {
+            wide_progress(geometry, storage, "a1 small prefill", width, 8192);
+            failures += run_a1_case(geometry, storage, prefill(width, 8192, 2201u),
+                                    MappingPattern::Fragmented);
+            failures +=
+                run_a1_case(geometry, storage, prefill(width, 31, 2202u), MappingPattern::Offset);
+        }
+        for (std::int32_t width : {17, 40, 64}) {
+            const std::int32_t threshold = width * keys_per_row;
+            for (std::int32_t visible : {threshold - 1, threshold}) {
+                wide_progress(geometry, storage, "a1 small prefill threshold", width,
+                              visible - width);
+                failures += run_a1_case(geometry, storage, prefill(width, visible - width, 2203u),
+                                        MappingPattern::Fragmented);
+            }
+        }
+    }
+    return failures;
+}
+
+KvCacheStorage invariance_storage(const CachePlan& plan) { return cache_plan_storage(plan); }
+
+KvCacheStorage invariance_storage(KvCacheStorage storage) { return storage; }
+
+// Speculative verification caps a round's live drafts by its output budget while the physical
+// width stays the family's. The live columns of a masked row must not depend on that cap: each
+// pair shares inputs, cache history and envelope and differs only in valid_columns, and the
+// shorter call's live columns must be bit-identical to the same columns of the longer one.
+// Contexts sit just below key-tile and partition boundaries, so a partition that followed the
+// live length would move.
+template <class Cache>
+int run_masked_prefix_invariance_case(const Geometry& geometry, const Cache& cache_spec,
+                                      std::int32_t width, const std::vector<std::int32_t>& contexts,
+                                      const std::vector<std::int32_t>& long_valid,
+                                      const std::vector<std::int32_t>& short_valid,
+                                      std::uint32_t seed) {
+    const auto batch     = static_cast<std::int32_t>(contexts.size());
+    std::int32_t maximum = 1;
+    for (const std::int32_t context : contexts) { maximum = std::max(maximum, context + width); }
+    const ops::CausalAttentionExecutionEnvelope envelope{1, static_cast<std::uint32_t>(maximum),
+                                                         false, batch == 1 && width > 16};
+    const std::size_t q_column_elements  = static_cast<std::size_t>(kHeadDim) * geometry.q_heads;
+    const std::size_t kv_column_elements = static_cast<std::size_t>(kHeadDim) * geometry.kv_heads;
+    const std::size_t columns            = static_cast<std::size_t>(width) * batch;
+    const auto q_bits =
+        to_bf16_bits(make_bf16_values(q_column_elements * columns, seed, -0.5f, 0.5f));
+    const auto k_bits =
+        to_bf16_bits(make_bf16_values(kv_column_elements * columns, seed + 1u, -0.5f, 0.5f));
+    const auto v_bits =
+        to_bf16_bits(make_bf16_values(kv_column_elements * columns, seed + 2u, -1.0f, 1.0f));
+    std::vector<HostCache> initial;
+    for (std::int32_t row = 0; row < batch; ++row) {
+        initial.push_back(make_cache(geometry, cache_spec, maximum + 3,
+                                     seed + 20u + 3u * static_cast<std::uint32_t>(row)));
+    }
+    std::vector<std::int32_t> table_rows(static_cast<std::size_t>(batch));
+    std::iota(table_rows.begin(), table_rows.end(), 0);
+    const std::size_t workspace_bytes = ops::causal_softmax_attention_workspace_capacity_bytes(
+        op_geometry(geometry), invariance_storage(cache_spec), envelope, batch, width, width);
+
+    const auto run = [&](const std::vector<std::int32_t>& valid) {
+        BatchDeviceCache cache(initial, MappingPattern::Fragmented);
+        GuardedDeviceBuffer dq(q_bits.size() * 2), dk(k_bits.size() * 2), dv(v_bits.size() * 2),
+            dp(columns * 4), dvalid(static_cast<std::size_t>(batch) * 4),
+            drows(static_cast<std::size_t>(batch) * 4), dout(q_bits.size() * 2);
+        GuardedDeviceBuffer scratch(std::max<std::size_t>(workspace_bytes, 256));
+        WorkspaceArena workspace(DeviceSpan{scratch.data(), scratch.bytes()});
+        std::vector<std::int32_t> positions(columns);
+        for (std::int32_t b = 0; b < batch; ++b) {
+            for (std::int32_t j = 0; j < width; ++j) {
+                positions[static_cast<std::size_t>(b * width + j)] =
+                    contexts[static_cast<std::size_t>(b)] +
+                    std::min(j, valid[static_cast<std::size_t>(b)] - 1);
+            }
+        }
+        dq.copy_from_host(q_bits.data(), q_bits.size() * 2);
+        dk.copy_from_host(k_bits.data(), k_bits.size() * 2);
+        dv.copy_from_host(v_bits.data(), v_bits.size() * 2);
+        dp.copy_from_host(positions.data(), positions.size() * 4);
+        dvalid.copy_from_host(valid.data(), valid.size() * 4);
+        drows.copy_from_host(table_rows.data(), table_rows.size() * 4);
+        const std::vector<std::uint16_t> canary(q_bits.size(), kOutputCanary);
+        dout.copy_from_host(canary.data(), canary.size() * 2);
+        Tensor tq(dq.data(), DType::BF16, {kHeadDim, geometry.q_heads, width, batch});
+        Tensor tk(dk.data(), DType::BF16, {kHeadDim, geometry.kv_heads, width, batch});
+        Tensor tv(dv.data(), DType::BF16, {kHeadDim, geometry.kv_heads, width, batch});
+        Tensor tp(dp.data(), DType::I32, {width, batch});
+        Tensor tvalid(dvalid.data(), DType::I32, {batch});
+        Tensor trows(drows.data(), DType::I32, {batch});
+        Tensor tout(dout.data(), DType::BF16, {kHeadDim, geometry.q_heads, width, batch});
+        ops::causal_softmax_attention(tq, tk, tv, tp, tvalid, trows, op_geometry(geometry),
+                                      kAttentionScale, cache.view(), envelope, workspace, tout,
+                                      nullptr);
+        cuda_synchronize();
+        return copy_from_guarded<std::uint16_t>(dout, q_bits.size());
+    };
+
+    const auto longer  = run(long_valid);
+    const auto shorter = run(short_valid);
+    int failures       = 0;
+    for (std::int32_t b = 0; b < batch; ++b) {
+        for (std::int32_t j = 0; j < short_valid[static_cast<std::size_t>(b)]; ++j) {
+            const std::size_t begin = static_cast<std::size_t>(b * width + j) * q_column_elements;
+            if (!std::equal(shorter.begin() + static_cast<std::ptrdiff_t>(begin),
+                            shorter.begin() +
+                                static_cast<std::ptrdiff_t>(begin + q_column_elements),
+                            longer.begin() + static_cast<std::ptrdiff_t>(begin))) {
+                if (failures == 0) {
+                    std::cerr << "masked prefix invariance " << geometry.name << ' '
+                              << cache_name(cache_spec) << " W=" << width << " B=" << batch
+                              << ": row " << b << " column " << j << " (context "
+                              << contexts[static_cast<std::size_t>(b)] << ", valid "
+                              << short_valid[static_cast<std::size_t>(b)] << " vs "
+                              << long_valid[static_cast<std::size_t>(b)] << ") differs\n";
+                }
+                ++failures;
+            }
+        }
+    }
+    return failures;
+}
+
+template <class Cache>
+int run_masked_prefix_invariance_cases(const Cache& cache_spec) {
+    int failures = 0;
+    for (const Geometry& geometry : kGeometries) {
+        for (const std::int32_t width : {8, 16, 32, 64}) {
+            for (const std::int32_t shorter : {1, width / 2, width - 1}) {
+                failures += run_masked_prefix_invariance_case(
+                    geometry, cache_spec, width, {8190}, {width}, {shorter},
+                    static_cast<std::uint32_t>(3100 + width + shorter));
+            }
+        }
+        // A long window: the split targets change tier past 16K visible keys.
+        for (const std::int32_t width : {8, 64}) {
+            for (const std::int32_t shorter : {1, width - 1}) {
+                failures += run_masked_prefix_invariance_case(
+                    geometry, cache_spec, width, {40958}, {width}, {shorter},
+                    static_cast<std::uint32_t>(3150 + width + shorter));
+            }
+        }
+        // Several requests, each capped differently (batched verification reaches 16 columns).
+        for (const std::int32_t width : {8, 16}) {
+            failures += run_masked_prefix_invariance_case(
+                geometry, cache_spec, width, {8190, 30718, 4094, 127}, {width, width, width, width},
+                {1, width / 2, width - 1, 3}, static_cast<std::uint32_t>(3200 + width));
+        }
+    }
+    return failures;
+}
+
+int run_masked_prefix_invariance_tests() {
+    int failures = 0;
+    for (const CachePlan& plan : {kPlanBf16, kPlanInt8, kPlanRk8v4, kPlanRk4v4}) {
+        failures += run_masked_prefix_invariance_cases(plan);
+    }
+    failures += run_case_allowing_arch_skip("masked prefix invariance FP8 KV cache", [] {
+        return run_masked_prefix_invariance_cases(kPlanFp8);
+    });
+    failures += run_case_allowing_arch_skip("masked prefix invariance nvfp4 KV cache", [] {
+        return run_masked_prefix_invariance_cases(KvCacheStorage::Nvfp4Group16);
+    });
+    failures += run_case_allowing_arch_skip("masked prefix invariance k8v4 KV cache", [] {
+        return run_masked_prefix_invariance_cases(KvCacheStorage::Fp8KeyNvfp4Value);
+    });
+    return failures;
+}
+
+int run_batch_cases() {
+    int failures = 0;
+    failures += run_batch_case(kGeometries[0], kPlanInt8,
+                               {6, {127}, {3}, {0}, MappingPattern::Identity, 499u});
+    failures += run_batch_case(kGeometries[0], kPlanBf16,
+                               {16, {49}, {7}, {0}, MappingPattern::Identity, 500u});
+    failures += run_batch_case(kGeometries[0], kPlanBf16,
+                               {1, {63, 2048}, {1, 1}, {1, 0}, MappingPattern::Fragmented, 501u});
+    failures += run_batch_case(kGeometries[1], kPlanInt8,
+                               {1,
+                                {0, 31, 63, 127, 511, 1023, 2047, 4095},
+                                {1, 1, 1, 1, 1, 1, 1, 1},
+                                {7, 0, 5, 2, 6, 1, 4, 3},
+                                MappingPattern::Identity,
+                                502u});
+    failures +=
+        run_batch_case(kGeometries[0], kPlanInt8,
+                       {6, {61, 127, 511}, {6, 3, 0}, {2, 0, 1}, MappingPattern::Fragmented, 503u});
+    failures += run_batch_case(kGeometries[1], kPlanBf16,
+                               {16, {49, 2041}, {16, 7}, {1, 0}, MappingPattern::Identity, 504u});
+    // rk8v4 packed values in the batched routes: the small-T fused-append rows (T=6) and
+    // the single-token long-context rows that drive the batched prompt layout.
+    failures += run_batch_case(
+        kGeometries[0], kPlanRk8v4, {6, {61, 127, 511}, {6, 3, 0}, {2, 0, 1},
+                                     MappingPattern::Fragmented, 506u});
+    failures += run_batch_case(
+        kGeometries[1], kPlanRk8v4, {1, {0, 31, 63, 127, 511, 1023, 2047, 4095},
+                                     {1, 1, 1, 1, 1, 1, 1, 1}, {7, 0, 5, 2, 6, 1, 4, 3},
+                                     MappingPattern::Identity, 507u});
+    // rk4v4 packed keys through the same batched routes.
+    failures += run_batch_case(
+        kGeometries[0], kPlanRk4v4, {6, {61, 127, 511}, {6, 3, 0}, {2, 0, 1},
+                                     MappingPattern::Fragmented, 508u});
+    failures += run_batch_case(
+        kGeometries[1], kPlanRk4v4, {1, {0, 31, 63, 127, 511, 1023, 2047, 4095},
+                                     {1, 1, 1, 1, 1, 1, 1, 1}, {7, 0, 5, 2, 6, 1, 4, 3},
+                                     MappingPattern::Identity, 509u});
+    // Single-row rk-family decode and verification through the whole-wave split policy, whose
+    // reducer now carries the gate: T=1 at 8K keys, and T=6 inside the 5K-8.2K split cap.
+    failures += run_batch_case(kGeometries[0], kPlanRk4v4,
+                               {1, {8191}, {1}, {0}, MappingPattern::Fragmented, 510u});
+    failures += run_batch_case(kGeometries[0], kPlanRk8v4,
+                               {6, {5600}, {6}, {0}, MappingPattern::Identity, 511u});
+    failures += run_case_allowing_arch_skip(
+        "causal_softmax_attention FP8 KV cache batched", [&] {
+            return run_batch_case(kGeometries[0], kPlanFp8,
+                                  {6, {61, 127, 511}, {6, 3, 0}, {2, 0, 1},
+                                   MappingPattern::Fragmented, 505u});
+        });
+    return failures;
+}
+
+// INT8 prompt-scale widths for one prompt kernel: partial row blocks, both fast-kernel CTA shapes
+// (its launcher picks four or eight warps from the width), and V magnitudes on either side of the
+// fast kernel's FP16-partial scale limit.
+int run_int8_prompt_cases(bool fast) {
+    constexpr KvCacheStorage storage = KvCacheStorage::Int8Group64;
+    int failures                     = 0;
+    const auto with                  = [fast](AttentionCase test_case) {
+        test_case.fast_prompt_kernel = fast;
+        return test_case;
+    };
+    const Geometry& h24 = kGeometries[0];
+    const Geometry& h16 = kGeometries[1];
+    failures += run_a1_case(h24, storage, with({300, 700, 1000, 901u}), MappingPattern::Fragmented);
+    failures += run_a3_case(h24, storage, with({300, 700, 1000, 902u}), MappingPattern::Identity);
+    failures += run_a1_case(h24, storage, with({1100, 0, 1100, 903u}), MappingPattern::Fragmented);
+    failures += run_a3_case(h24, storage, with({1057, 131, 1188, 904u}), MappingPattern::Offset);
+    failures += run_a1_case(h16, storage, with({1500, 500, 2000, 905u}), MappingPattern::Identity);
+    failures +=
+        run_a3_case(h16, storage, with({129, 2000, 2129, 906u}), MappingPattern::Fragmented);
+    // |V| up to 2048 puts group scales near 16, whose FP16 partials would overflow without the
+    // power-of-two rescale; |V| up to 900 keeps scales near 7, inside the unscaled FP16 path's
+    // margin.
+    failures += run_a1_case(h24, storage, with({200, 1000, 1200, 907u, false, false, 2048.0f}),
+                            MappingPattern::Identity);
+    failures += run_a3_case(h24, storage, with({1100, 64, 1164, 908u, false, false, 2048.0f}),
+                            MappingPattern::Fragmented);
+    failures += run_a3_case(h24, storage, with({640, 400, 1040, 909u, false, false, 900.0f}),
+                            MappingPattern::Identity);
+    failures += run_a1_case(h24, storage, with({600, 300, 900, 910u, false, true}),
+                            MappingPattern::Identity);
+    return failures;
+}
+
+// A V value past the FP16 scale range (|V| above 127 * 65504, 7 * 65504 for int4 codes, or an
+// infinite one, which a fault upstream can leave) stores an infinite group scale. Here every V
+// group scale of kv head 0 at one cached position is infinite, and every query row sees that
+// position, so the oracle's outputs of kv head 0's query heads are non-finite. The kernel must
+// return (the fast prompt kernel once rescaled such a tile forever), write those outputs non-finite
+// and the other heads as the oracle. The output canary is finite, so an unwritten output fails.
+int run_infinite_value_scale_case(const Geometry& geometry, KvCacheStorage storage,
+                                  const AttentionCase& test_case, MappingPattern mapping) {
+    const std::int32_t total       = test_case.base + test_case.tokens;
+    const std::int32_t max_context = static_cast<std::int32_t>(
+        std::max<std::uint32_t>(static_cast<std::uint32_t>(total + 3), test_case.envelope_max));
+    const std::size_t q_elements = static_cast<std::size_t>(kHeadDim) *
+                                   static_cast<std::size_t>(geometry.q_heads) *
+                                   static_cast<std::size_t>(test_case.tokens);
+    const std::vector<float> q = make_bf16_values(q_elements, test_case.seed, -0.25f, 0.25f);
+    std::vector<std::int32_t> positions(static_cast<std::size_t>(test_case.tokens));
+    for (std::int32_t token = 0; token < test_case.tokens; ++token) {
+        positions[static_cast<std::size_t>(token)] = test_case.base + token;
+    }
+    const ops::CausalAttentionExecutionEnvelope envelope{
+        static_cast<std::uint32_t>(total), test_case.envelope_max, test_case.fast_prompt_kernel,
+        test_case.wide_verification, test_case.small_prefill};
+
+    HostCache cache_host = make_cache(geometry, storage, max_context, test_case.seed + 10u);
+    const std::int32_t poisoned = test_case.base / 2;
+    if (cache_host.packed_values()) {
+        for (std::int32_t group = 0; group < kRk8ValueGroups; ++group) {
+            cache_host.v_scale[plane_scale_index(geometry, cache_host.logical_capacity, 0, poisoned,
+                                                 group, cache_host.v_scale_extent())] =
+                kF16Infinity;
+        }
+    } else {
+        for (std::int32_t group = 0; group < kQuantGroups; ++group) {
+            cache_host.v_scale[scale_index(geometry, cache_host.logical_capacity, 0, poisoned,
+                                           group)] = kF16Infinity;
+        }
+    }
+    const std::vector<double> reference = ideal_attention(q, cache_host, positions);
+    DeviceCache cache(cache_host, mapping);
+
+    const std::vector<std::uint16_t> q_bits = to_bf16_bits(q);
+    GuardedDeviceBuffer dq(q_bits.size() * sizeof(std::uint16_t));
+    GuardedDeviceBuffer dp(positions.size() * sizeof(std::int32_t));
+    GuardedDeviceBuffer dout(q_bits.size() * sizeof(std::uint16_t));
+    dq.copy_from_host(q_bits.data(), q_bits.size() * sizeof(std::uint16_t));
+    dp.copy_from_host(positions.data(), positions.size() * sizeof(std::int32_t));
+    std::vector<std::uint16_t> output_canary(q_bits.size(), kFiniteOutputCanary);
+    dout.copy_from_host(output_canary.data(), output_canary.size() * sizeof(std::uint16_t));
+
+    Tensor tq(dq.data(), DType::BF16, {kHeadDim, geometry.q_heads, test_case.tokens});
+    Tensor tp(dp.data(), DType::I32, {test_case.tokens});
+    Tensor tout(dout.data(), DType::BF16, {kHeadDim, geometry.q_heads, test_case.tokens});
+    const std::size_t workspace_bytes = ops::causal_softmax_attention_workspace_capacity_bytes(
+        op_geometry(geometry), storage, envelope, 1, test_case.tokens, test_case.tokens);
+    GuardedDeviceBuffer workspace_buffer(std::max<std::size_t>(workspace_bytes, 256));
+    WorkspaceArena workspace(DeviceSpan{workspace_buffer.data(), workspace_buffer.bytes()});
+
+    ops::causal_softmax_attention_cached(tq, tp, op_geometry(geometry), kAttentionScale,
+                                         cache.view(), envelope, workspace, tout, nullptr);
+    cuda_synchronize();
+
+    const std::string label = case_label("causal_softmax_attention_cached infinite V scale",
+                                         geometry, storage, test_case, mapping);
+    const std::vector<double> output =
+        bf16_bits_to_double(copy_from_guarded<std::uint16_t>(dout, q_bits.size()));
+    std::vector<double> other_output;
+    std::vector<double> other_reference;
+    std::size_t finite        = 0;
+    std::size_t oracle_finite = 0;
+    for (std::int32_t token = 0; token < test_case.tokens; ++token) {
+        for (std::int32_t head = 0; head < geometry.q_heads; ++head) {
+            for (std::int32_t d = 0; d < kHeadDim; ++d) {
+                const std::size_t index = q_index(geometry, head, d, token);
+                if (head < geometry.query_group()) {
+                    finite += std::isfinite(output[index]) ? 1 : 0;
+                    oracle_finite += std::isfinite(reference[index]) ? 1 : 0;
+                } else {
+                    other_output.push_back(output[index]);
+                    other_reference.push_back(reference[index]);
+                }
+            }
+        }
+    }
+    int failures = 0;
+    if (oracle_finite != 0) {
+        std::cerr << label << ": " << oracle_finite << " oracle outputs of kv head 0 are finite\n";
+        ++failures;
+    }
+    if (finite != 0) {
+        std::cerr << label << ": " << finite << " outputs of kv head 0 are finite\n";
+        ++failures;
+    }
+    failures += verify_attention(label + " other kv heads", other_output, other_reference,
+                                 attention_criterion(storage));
+    failures += dout.verify_guards((label + " output").c_str());
+    failures += workspace_buffer.verify_guards((label + " workspace").c_str());
+    failures += cache.verify_guards(label);
+    return failures;
+}
+
+// Infinite V group scales for one INT8-family prompt kernel: INT8 and packed INT4 values, over a
+// wide launch and a narrow one past a deeper cache.
+int run_infinite_value_scale_cases(bool fast) {
+    const auto with = [fast](AttentionCase test_case) {
+        test_case.fast_prompt_kernel = fast;
+        return test_case;
+    };
+    int failures = 0;
+    for (const KvCacheStorage storage :
+         {KvCacheStorage::Int8Group64, KvCacheStorage::RotatedInt4KeyInt4ValueE8}) {
+        failures += run_infinite_value_scale_case(kGeometries[0], storage,
+                                                  with({300, 700, 1000, 961u}),
+                                                  MappingPattern::Fragmented);
+        failures += run_infinite_value_scale_case(kGeometries[1], storage,
+                                                  with({129, 2000, 2129, 962u}),
+                                                  MappingPattern::Identity);
+    }
+    return failures;
+}
+
+// BF16 values beyond FP16's range. Turing builds run BF16-cache attention on FP16 MMA and stage a
+// tile that holds such a value as BF16 for the exact emulation (common/bf16_attention.cuh): values
+// of up to 2^17 send every tile there, one key of 2^17 its own tile only. Decode, verification and
+// prompt widths.
+int run_bf16_range_cases() {
+    constexpr KvCacheStorage storage = KvCacheStorage::BFloat16;
+    constexpr float kBeyondFp16      = 131072.0f;
+    const auto key_case = [](std::int32_t tokens, std::int32_t base, std::uint32_t seed) {
+        AttentionCase test_case{tokens, base, static_cast<std::uint32_t>(base + tokens), seed};
+        test_case.key_beyond_fp16 = true;
+        return test_case;
+    };
+    int failures = 0;
+    for (const Geometry& geometry : kGeometries) {
+        failures += run_a1_case(geometry, storage, {1, 700, 701, 951u, false, false, kBeyondFp16},
+                                MappingPattern::Fragmented);
+        failures += run_a3_case(geometry, storage, {4, 300, 304, 952u, false, false, kBeyondFp16},
+                                MappingPattern::Identity);
+        failures += run_a1_case(geometry, storage, {300, 200, 500, 953u, false, false, kBeyondFp16},
+                                MappingPattern::Offset);
+        failures +=
+            run_a1_case(geometry, storage, key_case(4, 700, 954u), MappingPattern::Fragmented);
+        failures +=
+            run_a1_case(geometry, storage, key_case(300, 200, 955u), MappingPattern::Identity);
+    }
+    return failures;
+}
+
+int run_geometry(const Geometry& geometry) {
+    int failures = 0;
+    for (const CachePlan& plan : {kPlanBf16, kPlanInt8, kPlanRk8v4}) {
+        for (const MappingPattern mapping :
+             {MappingPattern::Identity, MappingPattern::Offset, MappingPattern::Fragmented}) {
+            failures += run_a1_case(geometry, plan, {6, 61, 67, 190u}, mapping);
+            failures += run_a3_case(geometry, plan, {1, 128, 129, 191u}, mapping);
+        }
+
+        const AttentionCase a1_cases[] = {
+            {1, 0, 1, 201u},    {6, 17, 23, 202u},   {7, 17, 512, 203u},
+            {17, 31, 48, 204u}, {66, 63, 129, 205u},
+        };
+        for (const AttentionCase& test_case : a1_cases) {
+            failures += run_a1_case(geometry, plan, test_case, MappingPattern::Identity);
+        }
+
+        const AttentionCase a3_cases[] = {
+            {1, 31, 32, 301u},
+            {7, 17, 512, 302u},
+            {17, 31, 48, 303u},
+        };
+        for (const AttentionCase& test_case : a3_cases) {
+            failures += run_a3_case(geometry, plan, test_case, MappingPattern::Identity);
+        }
+
+        if (geometry.q_heads == 16) {
+            // Loose execution envelopes straddle the two registered host-resource frontiers.
+            // Device positions, not these bounds, continue to define the oracle result.
+            failures += run_a1_case(geometry, plan, {7, 17, 513, 401u}, MappingPattern::Identity);
+            failures += run_a3_case(geometry, plan, {7, 17, 513, 402u}, MappingPattern::Identity);
+            failures +=
+                run_a3_case(geometry, plan, {16, 17, 1024, 403u}, MappingPattern::Identity);
+            failures +=
+                run_a3_case(geometry, plan, {16, 17, 1025, 404u}, MappingPattern::Identity);
+        }
+    }
+    return failures;
+}
+
+// FP8 decode attention (small_t, T<=6) dequantizes K to BF16 and V to FP16 before ordinary MMA
+// and is ported to sm_86/sm_89; the prompt (T>6) kernel still needs the FP8 mma.sync...f8f6f4
+// QK matmul (Blackwell-only) rewritten the same way. Kept in separate functions -- rather than
+// one run_fp8_cases() wrapped by a single run_case_allowing_arch_skip -- so a still-rejected
+// prompt case can't unwind past (and hide the result of) an already-ported decode case that
+// happened to run first in the same try block.
+int run_fp8_decode_cases() {
+    int failures = 0;
+    for (const Geometry& geometry : kGeometries) {
+        failures += run_a1_case(geometry, kPlanFp8, {1, 128, 192, 603u},
+                                MappingPattern::Fragmented);
+        failures +=
+            run_a3_case(geometry, kPlanFp8, {1, 128, 192, 604u}, MappingPattern::Offset);
+        failures += run_a1_case(geometry, kPlanFp8, {6, 61, 192, 605u},
+                                MappingPattern::Fragmented);
+    }
+    failures += run_a3_case(kGeometries[0], kPlanFp8, {3, 63, 192, 606u},
+                            MappingPattern::Identity);
+    failures += run_a1_case(kGeometries[0], kPlanFp8, {1, 16384, 16385, 607u},
+                            MappingPattern::Fragmented);
+    return failures;
+}
+
+int run_fp8_prompt_cases() {
+    int failures = 0;
+    for (const Geometry& geometry : kGeometries) {
+        failures += run_a1_case(geometry, kPlanFp8, {65, 63, 192, 601u},
+                                MappingPattern::Fragmented);
+        failures += run_a3_case(geometry, kPlanFp8, {65, 63, 192, 602u},
+                                MappingPattern::Fragmented);
+    }
+    return failures;
+}
+
+// RotorQuant-style rk8v4: rotated INT8 G64 keys plus unrotated packed signed-INT4
+// values with one FP16 scale per 32-value group (G32). This is the shipped compact KV
+// profile, but the consumer attention kernels only ever ran against BF16/INT8/FP8 caches,
+// so the packed value plane (and its shared-memory scale layout in both the prompt and
+// small-T routes) needs direct oracle coverage here. Unlike FP8, INT4 packing needs no
+// arch feature, so these cases run on every build the INT8 cases run on.
+int run_rk8v4_cases() {
+    std::cout << "  rk8v4 (INT8-G64 rotated keys + packed INT4 G32 values):\n";
+    int failures = 0;
+    for (const Geometry& geometry : kGeometries) {
+        // T >= 7: prompt route over the packed cache; the append writes packed V and
+        // G32 scales that the prompt kernel then decodes (both static-smem T and the
+        // dynamic-arena T >= 7 layout).
+        failures += run_a1_case(geometry, kPlanRk8v4, {65, 63, 192, 611u},
+                                MappingPattern::Fragmented);
+        failures += run_a3_case(geometry, kPlanRk8v4, {65, 63, 192, 612u},
+                                MappingPattern::Fragmented);
+        // Small-T prompt route (T <= 6) with the fused append writing the packed plane.
+        failures += run_a1_case(geometry, kPlanRk8v4, {1, 128, 192, 613u},
+                                MappingPattern::Fragmented);
+        failures +=
+            run_a3_case(geometry, kPlanRk8v4, {1, 128, 192, 614u}, MappingPattern::Offset);
+        failures += run_a1_case(geometry, kPlanRk8v4, {6, 61, 192, 615u},
+                                MappingPattern::Fragmented);
+    }
+    failures += run_a3_case(kGeometries[0], kPlanRk8v4, {3, 63, 192, 616u},
+                            MappingPattern::Identity);
+    failures += run_a1_case(kGeometries[0], kPlanRk8v4, {1, 16384, 16385, 617u},
+                            MappingPattern::Fragmented);
+    return failures;
+}
+
+// rk4v4: rotated 4-bit Lloyd-Max key indices over a G64 FP16 scale plus rk8v4's packed INT4 G32
+// values. Both attention kernels load the packed keys into registers and expand them to INT8 codes
+// in the shared K tile, so this covers each kernel's staging at its tile shapes: the prompt kernel
+// (T >= 7, one 64-key tile per page), every small-T warp/key-block schedule (the window tiers
+// select 32- and 64-key blocks and 6- to 32-warp CTAs), the fused append, graph replay, and a
+// long split-KV window.
+int run_rk4v4_cases() {
+    std::cout << "  rk4v4 (Lloyd-Max 4-bit rotated keys + packed INT4 G32 values):\n";
+    int failures = 0;
+    for (const Geometry& geometry : kGeometries) {
+        for (const MappingPattern mapping :
+             {MappingPattern::Identity, MappingPattern::Offset, MappingPattern::Fragmented}) {
+            failures += run_a1_case(geometry, kPlanRk4v4, {6, 61, 67, 190u}, mapping);
+            failures += run_a3_case(geometry, kPlanRk4v4, {1, 128, 129, 191u}, mapping);
+        }
+        failures += run_a1_case(geometry, kPlanRk4v4, {65, 63, 192, 621u},
+                                MappingPattern::Fragmented);
+        failures += run_a3_case(geometry, kPlanRk4v4, {65, 63, 192, 622u},
+                                MappingPattern::Fragmented);
+        failures += run_a1_case(geometry, kPlanRk4v4, {1, 0, 1, 623u}, MappingPattern::Identity);
+        failures += run_a1_case(geometry, kPlanRk4v4, {1, 128, 192, 624u},
+                                MappingPattern::Fragmented);
+        failures +=
+            run_a3_case(geometry, kPlanRk4v4, {1, 128, 192, 625u}, MappingPattern::Offset);
+        failures += run_a1_case(geometry, kPlanRk4v4, {6, 61, 192, 626u},
+                                MappingPattern::Fragmented);
+        failures += run_a1_case(geometry, kPlanRk4v4, {7, 17, 512, 627u},
+                                MappingPattern::Identity);
+        failures += run_a3_case(geometry, kPlanRk4v4, {17, 31, 48, 628u},
+                                MappingPattern::Identity);
+        // Window tiers of the small-T schedule: <= 1029/2054, <= 4096/8198 (64-key blocks under
+        // T >= 6), and the long split-KV tier.
+        for (const std::int32_t depth : {1000, 2000, 6000, 20000}) {
+            failures += run_a1_case(geometry, kPlanRk4v4,
+                                    {1, depth, static_cast<std::uint32_t>(depth + 1), 629u},
+                                    MappingPattern::Fragmented);
+            failures += run_a1_case(geometry, kPlanRk4v4,
+                                    {6, depth, static_cast<std::uint32_t>(depth + 6), 630u},
+                                    MappingPattern::Fragmented);
+        }
+        failures += run_a1_case(geometry, kPlanRk4v4, {4, 3000, 3004, 631u, false, true},
+                                MappingPattern::Fragmented);
+    }
+    failures += run_a3_case(kGeometries[0], kPlanRk4v4, {3, 63, 192, 632u},
+                            MappingPattern::Identity);
+    failures += run_a1_case(kGeometries[0], kPlanRk4v4, {8, 5000, 5008, 633u},
+                            MappingPattern::Fragmented);
+    return failures;
+}
+
+// rk4v4-e8: rotated keys snapped to the E8 lattice per octet and stored as packed INT4 G64,
+// values as in rk8v4. Same route coverage as rk8v4, plus T=8 (a DFlash2 K=7 verify step).
+int run_rk4v4_e8_cases() {
+    std::cout << "  rk4v4-e8 (E8 lattice INT4-G64 rotated keys + packed INT4 G32 values):\n";
+    constexpr KvCacheStorage kE8 = KvCacheStorage::RotatedInt4KeyInt4ValueE8;
+    int failures = 0;
+    for (const Geometry& geometry : kGeometries) {
+        failures += run_a1_case(geometry, kE8, {65, 63, 192, 811u}, MappingPattern::Fragmented);
+        failures += run_a3_case(geometry, kE8, {65, 63, 192, 812u}, MappingPattern::Fragmented);
+        failures += run_a1_case(geometry, kE8, {1, 128, 192, 813u}, MappingPattern::Fragmented);
+        failures += run_a3_case(geometry, kE8, {1, 128, 192, 814u}, MappingPattern::Offset);
+        failures += run_a1_case(geometry, kE8, {6, 61, 192, 815u}, MappingPattern::Fragmented);
+        failures += run_a1_case(geometry, kE8, {8, 61, 192, 816u}, MappingPattern::Identity);
+    }
+    failures += run_a3_case(kGeometries[0], kE8, {3, 63, 192, 817u}, MappingPattern::Identity);
+    failures += run_a1_case(kGeometries[0], kE8, {1, 16384, 16385, 818u},
+                            MappingPattern::Fragmented);
+    failures += run_quantized_batch_cases(kE8, 820u);
+    failures += report_quantization_quality(kE8, 830u);
+    return failures;
+}
