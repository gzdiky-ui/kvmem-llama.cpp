+#include "ops/softmax_attention/dense/causal_cache/small_t_fp8.cuh"
+#include "ops/kv_cache/plane_types.h"
+#if defined(NINFER_TIER_VOLTA)
+#    include "ops/softmax_attention/dense/causal_cache/small_t_sm70.cuh"
+#endif
+
+#include <cstdint>
+#include <stdexcept>
