-        for (const auto storage : {KvCacheStorage::Fp8E4M3Row256,
-                                   KvCacheStorage::Nvfp4Group16,
-                                   KvCacheStorage::Fp8KeyNvfp4Value}) {
-            for (const int depth : {8192, 61440}) {
