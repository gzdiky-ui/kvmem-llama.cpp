 # Tests
 
+The local `ninfer_nvfp4_routing_*` checks cover default W4A8 admission at the MTP
+projection shape and family isolation under four scoped overrides. Each override
+runs in a separate process. `ninfer_nvfp4_mode_binding` additionally checks native
+snapshot isolation for explicit W4A16/W4A8 modes, and skips without a model fixture.
+
 The retained tests protect current `.ninfer`, numerical operator, model, runtime-transaction,
 benchmark-report, and external protocol behavior. Repository verification principles are defined in
 [`../AGENTS.md`](../AGENTS.md); Op contract and CUDA implementation guidance is in
diff --git a/tests/experimental/nvfp4_mode_binding.cpp b/tests/experimental/nvfp4_mode_binding.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..2733b86d844d767763b90d21e9f0952e8d771010
--- /dev/null
+++ b/tests/experimental/nvfp4_mode_binding.cpp
@@ -0,0 +1,61 @@
+#include "ninfer/engine.h"
+#include <filesystem>
+#include <iostream>
+#include <stdexcept>
+
+namespace {
+void require(bool condition,const char* message) {if(!condition) throw std::runtime_error(message);}
+ninfer::EngineOptions options(const char* artifact) {
+    ninfer::EngineOptions out;
+    out.artifact_path=artifact;out.device_profile="off";out.max_context=1024;
+    out.kv_capacity=ninfer::KvCapacityPolicy::explicit_capacity(1024);out.prefill_chunk=128;
+    out.use_cuda_graph=false;out.speculative.backend=ninfer::SpeculativeBackend::None;
+    out.speculative.ngram_draft_tokens=0;out.max_concurrency=1;
+    out.context_cache.device_state_slots=1;out.context_cache.host_state_slots=0;
+    out.context_cache.host_kv_capacity_bytes=0;out.context_cache.max_private_continuations=1;
+    out.context_cache.max_shared_prefixes=0;
+    return out;
+}
+void save(ninfer::Engine& engine,const std::string& path) {
+    ninfer::PromptInput prompt;prompt.options.enable_thinking=false;
+    ninfer::ChatMessage message;message.role=ninfer::ChatRole::User;
+    message.parts.push_back({.kind=ninfer::MessagePartKind::Text,.text="Return one word."});
+    prompt.messages.push_back(std::move(message));
+    ninfer::RequestOptions request;request.execution.requested_output_tokens=2;
+    request.execution.sampling.temperature=0;request.stop.include_model_defaults=false;
+    const auto result=engine.generate(engine.prepare(prompt),request);
+    require(result.slot>=0,"fixture did not retain a native slot");
+    require(engine.save_slot(static_cast<std::uint32_t>(result.slot),path).bytes>0,"empty snapshot");
+}
+void reject(ninfer::Engine& engine,const std::string& path) {
+    bool refused=false;
+    try {(void)engine.restore_slot(0,path);} catch(const std::invalid_argument& error) {
+        refused=std::string(error.what()).find("different model")!=std::string::npos;
+    }
+    require(refused,"snapshot from another weight mode was accepted");
+}
+}
+int main(int argc,char** argv) {
+    if (argc!=3) {
+        std::cout<<"SKIP: provide artifact and output-directory for native snapshot mode binding\n";
+        return 77;
+    }
+    try {
+        const auto directory=std::filesystem::absolute(argv[2]);std::filesystem::create_directories(directory);
+        const auto base_file=(directory/"default.bin").string(),a16_file=(directory/"a16.bin").string();
+        std::string base,a16;
+        {ninfer::Engine engine(options(argv[1]));base=engine.load_summary().prefill_signature;save(engine,base_file);}
+        {auto o=options(argv[1]);o.nvfp4_w4a16=true;ninfer::Engine engine(o);
+         a16=engine.load_summary().prefill_signature;require(a16!=base,"W4A16 signature equals default");
+         reject(engine,base_file);save(engine,a16_file);}
+        {auto o=options(argv[1]);o.nvfp4_w4a8_int=true;ninfer::Engine engine(o);
+         const auto signature=engine.load_summary().prefill_signature;
+         require(signature!=base && signature!=a16,"W4A8 signature collides with another mode");
+         reject(engine,base_file);reject(engine,a16_file);}
+        {auto o=options(argv[1]);o.nvfp4_w4a16=true;o.nvfp4_w4a8_int=true;ninfer::Engine engine(o);
+         require(engine.load_summary().prefill_signature==a16,"W4A16 precedence changes signature");
+         require(engine.restore_slot(0,a16_file).tokens>0,"same effective mode restore failed");}
+        std::cout<<"NVFP4 mode signatures and native snapshot isolation passed; non-NVFP4 fixture qualifies binding only\n";
+        return 0;
+    } catch(const std::exception& error) {std::cerr<<error.what()<<'\n';return 1;}
+}
diff --git a/tests/experimental/nvfp4_scope.cpp b/tests/experimental/nvfp4_scope.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..837a5c446a9b8be4b5eec67dd3013c2bfaa15a98
--- /dev/null
+++ b/tests/experimental/nvfp4_scope.cpp
@@ -0,0 +1,72 @@
+#include "ninfer/ops/linear.h"
+#include "ops/linear/common/route_table.h"
+#include "ops/common/device_route.h"
+#include <cuda_runtime.h>
+#include <cstdlib>
+#include <exception>
+#include <iostream>
+#include <stdexcept>
+#include <string_view>
+#include <utility>
+
+void check_route_selection() {
+    using namespace ninfer;
+    using namespace ops::detail;
+    if (!unified_linear_routes_here()) return;
+    const char* value = std::getenv("NINFER_LINEAR_ROUTES");
+    const std::string_view spec = value == nullptr ? "" : value;
+    const bool int8_scope = spec.starts_with("int8:");
+    const bool a16_scope = spec.starts_with("a16:");
+    if (!spec.empty() && !int8_scope && !a16_scope) {
+        throw std::invalid_argument("routing check requires default or scoped NVFP4 environment");
+    }
+    const auto forced = spec.ends_with(":unified") ? LinearRouteTable::Unified
+                                                  : LinearRouteTable::Legacy;
+    const auto int8_table = int8_scope ? forced : LinearRouteTable::Unified;
+    const auto a16_table = a16_scope ? forced : LinearRouteTable::Legacy;
+    for (int width : {1, 2, 8, 9, 32, 129, 2048}) {
+        if (linear_route_table(LinearRouteFamily::Nvfp4Int8, width) != int8_table) {
+            throw std::runtime_error("plain W4A8 selected an unexpected route");
+        }
+    }
+    if (linear_route_table(LinearRouteFamily::Nvfp4, 2048) != a16_table ||
+        linear_route_table(LinearRouteFamily::Q4, 2048) != LinearRouteTable::Legacy) {
+        throw std::runtime_error("NVFP4 override changed a different plain Linear family");
+    }
+    // Give both fused families the opposite profile schedule so a leaked scope is observable.
+    const auto baseline = forced == LinearRouteTable::Unified ? LinearRouteTable::Legacy
+                                                             : LinearRouteTable::Unified;
+    const char* schedule = baseline == LinearRouteTable::Unified ? "unified" : "";
+    for (const auto& [key, expected] : {
+             std::pair{"unified/nvfp4_linear_add", a16_scope ? forced : baseline},
+             std::pair{"nvfp4_int8/linear_add", int8_scope ? forced : baseline},
+             std::pair{"unified/fp8_linear_add", baseline}}) {
+        const ops::DeviceRouteForce route(key, schedule);
+        if (fused_route_table(key, 1) != expected) {
+            throw std::runtime_error("NVFP4 override crossed fused family boundaries");
+        }
+    }
+    bool rejected = false;
+    try {
+        const auto bytes = ops::linear_workspace_capacity_bytes(
+            QType::NVFP4, 14336, 5120, ops::LinearPolicy::AllowNvfp4Int8, 1, 129);
+        if (bytes == 0) throw std::runtime_error("W4A8 projection needs activation workspace");
+    } catch (const std::invalid_argument&) { rejected = true; }
+    if (rejected != (int8_table == LinearRouteTable::Legacy)) {
+        throw std::runtime_error("MTP-shaped W4A8 workspace admission disagrees with selected route");
+    }
+}
+
+int main() {
+    int count = 0;
+    if (cudaGetDeviceCount(&count) != cudaSuccess || count == 0) return 77;
+    if (!ninfer::ops::detail::unified_linear_routes_here()) return 77;
+    try {
+        check_route_selection();
+        std::cout << "NVFP4 default/scoped routing passed\n";
+        return 0;
+    } catch (const std::exception& error) {
+        std::cerr << error.what() << '\n';
+        return 1;
+    }
+}
